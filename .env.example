# RoboSystems API — https://api.robosystems.ai for the managed cloud,
# http://localhost:8000 for a local development stack.
ROBOSYSTEMS_API_URL=https://api.robosystems.ai

# API key for the graph you integrate with (X-API-Key header).
ROBOSYSTEMS_API_KEY=

# The graph this integration writes to (kg...).
ROBOSYSTEMS_GRAPH_ID=

# Your integration's registered source name — the identity stamp on
# everything it writes (lane 1 Event.source / lane 2 source_system).
INTEGRATION_SOURCE_NAME=myintegration

# Optional source credentials — each source is skipped when unset.

# GitHub PAT with push access on the tracked repos: repo traffic.
# GITHUB_TOKEN=

# Cloudflare Web Analytics (account-owned token, Analytics Read).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# One read-only Google grant covering Search Console and YouTube —
# mint it with `just google-auth`. GSC_* / YOUTUBE_* (same three
# suffixes) override it per service.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# X API v2 app bearer token: follower count.
# X_BEARER_TOKEN=

# Buffer API key: LinkedIn / X post impressions.
# BUFFER_API_KEY=
